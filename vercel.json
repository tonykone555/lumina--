{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "rembg",
          "format": "url",
          "env": "REMBG_INTERNAL_URL"
        }
      ]
    },
    "rembg": {
      "root": "services/rembg",
      "framework": "fastapi",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/admin/ads/automation/run",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/growth/threads/auto/run",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/commerce/product-universe/research?limit=25&country=US",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/commerce/product-universe/sync-taxonomy",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/admin/growth/buyer-radar/run",
      "schedule": "0 * * * *"
    }
  ]
}
