# Optional emergency kill switches. Set either value to false to disable that flow.
YNOT_CHECKOUT_ENABLED=
YNOT_MANUAL_PROCUREMENT_ENABLED=
YNOT_APPROVAL_WINDOW_MINUTES=10
YNOT_MIN_REALIZED_MARGIN_EUR=5
YNOT_MANUAL_SHIPPING_JSON={"default":0}
YNOT_APPROVED_SUPPLIER_DOMAINS=example-shop.com
YNOT_SUPPLIER_SHIPPING_JSON={"example-shop.com":5.95}
YNOT_OWNED_INVENTORY_JSON={}
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Add these only through Vercel sensitive environment variables.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
YNOT_CHECKOUT_SIGNING_SECRET=
YNOT_OPERATOR_SECRET=

# Optional HTTPS endpoint for owner order notifications.
YNOT_OPERATOR_NOTIFICATION_URL=

UNSPLASH_ACCESS_KEY=replace-with-unsplash-access-key
EBAY_CLIENT_ID=replace-with-production-app-id
EBAY_CLIENT_SECRET=replace-with-production-cert-id

# Instagram discovery (server-only)
APIFY_API_TOKEN=replace-with-apify-token
APIFY_KEYWORD_ACTOR=publicsignallabs~instagram-account-search
APIFY_RELATED_ACTOR=publicsignallabs~instagram-related-profiles

# Supabase server connection. Vercel's Supabase integration supplies the
# NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY form. Legacy names still work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# YNOT MCP (server-only). Generate a long random bearer token in Vercel.
YNOT_MCP_TOKEN=
